{
  "name": "aurolith",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run typecheck && npm run build -w client",
    "typecheck": "tsc --noEmit -p shared && tsc --noEmit -p client && tsc --noEmit -p server",
    "test": "vitest run",
    "smoke": "node scripts/browser-smoke.mjs",
    "stage2:terrain-review": "node scripts/stage2-terrain-visual-review.mjs",
    "stage1:playthrough": "node scripts/stage1-playthrough.mjs",
    "stage2:playthrough": "node scripts/stage2-playthrough.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
